---
// Thin English route wrapper — view logic lives in UtilityPlaceholderView.
import UtilityPlaceholderView from '../../views/UtilityPlaceholderView.astro';
import { utilities } from '../../platform/utilities.ts';

export function getStaticPaths() {
	return utilities
		.filter((utility) => utility.route.startsWith('/utilities/') && utility.implementationState === 'placeholder')
		.map((utility) => ({ params: { slug: utility.slug }, props: { utility } }));
}

const { utility } = Astro.props;
---

<UtilityPlaceholderView utility={utility} locale="en" />
