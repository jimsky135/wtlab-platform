---
// Thin English route wrapper — view logic lives in WorkspacePlaceholderView.
import WorkspacePlaceholderView from '../../views/WorkspacePlaceholderView.astro';
import { workspaces } from '../../platform/workspaces';

export function getStaticPaths() {
	return workspaces
		.filter(
			(workspace) =>
				workspace.route.startsWith('/workspace/') &&
				workspace.implementationState === 'placeholder' &&
				// The Integrated Workspace has its own page now; this dynamic route
				// serves the archived prototypes only.
				workspace.surface === 'archived'
		)
		.map((workspace) => ({ params: { slug: workspace.slug }, props: { workspace } }));
}

const { workspace } = Astro.props;
---

<WorkspacePlaceholderView workspace={workspace} locale="en" />
