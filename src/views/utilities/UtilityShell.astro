---
// Utility Shell (Sprint 010A) — shared chrome for any Utility page: header,
// description, metadata, status, and a slot for the actual workspace body.
// Deliberately the Utilities equivalent of InstrumentHeader.astro, but its
// own component: Utilities carry different metadata (category/inputType/
// outputType, no coreQuestion) and their own simpler status vocabulary
// (platform/utility-catalog.ts), so it does not import anything from the
// Instrument Factory. Contains NO business logic — every future Utility
// (starting with Excel Preprocessor in Sprint 010B) wraps its own
// transformation UI in this shell via the default slot.
import { getDictionary, localizePath, type Locale } from '../../i18n';
import PlatformShell from '../../layouts/PlatformShell.astro';
import type { UtilityEntry } from '../../platform/utility-catalog.ts';

interface Props {
	utility: UtilityEntry;
	locale?: Locale;
}

const { utility, locale = 'en' } = Astro.props;
const t = getDictionary(locale);
const text = t.utilities[utility.id] ?? utility;
const statusText = t.common.utilityStatusTag;
---

<PlatformShell title={`${text.displayName} · ${t.seo.titleSuffix}`} section="utilities" locale={locale}>
	<article class="utility-page">
		<header class="utility-header">
			<p class="kicker">{t.utilityPlaceholder.kickerPrefix} · {utility.category}</p>
			<h1><span class="icon" aria-hidden="true">{utility.icon}</span> {text.displayName}</h1>
			<p class="status-tags">
				<span class:list={['tag', utility.status === 'available' ? 'tag-live' : undefined]}>
					{statusText.status[utility.status]}
				</span>
				<span class="tag">{statusText.implementationState[utility.implementationState]}</span>
			</p>
			<dl class="meta">
				<dt>{t.utilityPlaceholder.purposeLabel}</dt>
				<dd>{text.description}</dd>
				<dt>{t.utilityPlaceholder.categoryLabel}</dt>
				<dd>{utility.category}</dd>
				<dt>{t.utilityPlaceholder.inputTypeLabel}</dt>
				<dd>{utility.inputType}</dd>
				<dt>{t.utilityPlaceholder.outputTypeLabel}</dt>
				<dd>{utility.outputType}</dd>
			</dl>
			<nav class="utility-nav" aria-label="Utility">
				<a href={localizePath(locale, '/utilities')}>{t.utilityPlaceholder.backLink}</a>
				<a href={localizePath(locale, '/command')}>{t.nav.items.today}</a>
			</nav>
		</header>

		<div class="utility-workspace">
			<slot />
		</div>
	</article>
</PlatformShell>

<style>
	.kicker {
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: var(--tracking-kicker);
		text-transform: uppercase;
		color: var(--color-accent);
		margin: 0 0 var(--space-sm);
	}

	h1 {
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 400;
		font-size: clamp(2rem, 5vw, 3rem);
		margin: 0 0 var(--space-sm);
		display: flex;
		align-items: baseline;
		gap: var(--space-sm);
	}

	.icon {
		font-style: normal;
	}

	.status-tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-xs);
		margin: 0;
	}

	.tag {
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-text-secondary);
		border: var(--border-hairline);
		padding: 2px 8px;
	}

	.tag-live {
		color: var(--color-accent);
		border-color: var(--color-accent);
	}

	.meta {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: var(--space-xs) var(--space-md);
		margin: var(--space-md) 0 0;
	}

	.meta dt {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: var(--tracking-kicker);
		text-transform: uppercase;
		color: var(--color-text-tertiary);
	}

	.meta dd {
		margin: 0;
		color: var(--color-text-primary);
	}

	.utility-nav {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-md);
		margin-top: var(--space-md);
	}

	.utility-nav a {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: var(--tracking-kicker);
		text-transform: uppercase;
		color: var(--color-accent);
		text-decoration: none;
	}

	.utility-workspace {
		margin-top: var(--space-xl);
		border-top: var(--border-hairline);
		padding-top: var(--space-lg);
	}
</style>
