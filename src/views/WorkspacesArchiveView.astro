---
// Archive of workspace prototypes taken off the main product surface.
//
// Preservation, not deletion: every entry here is still the same record in
// platform/workspaces.ts, still carries its original name, description,
// status and route, and its page still resolves. Nothing is duplicated —
// this view reads the same catalog the main list reads, filtered by
// `surface`.
import StatusTag from '../components/StatusTag.astro';
import PlatformShell from '../layouts/PlatformShell.astro';
import { getDictionary, localizePath, type Locale } from '../i18n';
import { workspaces } from '../platform/workspaces';

interface Props {
	locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const t = getDictionary(locale);
const archived = workspaces.filter((workspace) => workspace.surface === 'archived');
---

<PlatformShell title={`${t.workspacesArchive.heading} · ${t.seo.titleSuffix}`} section="workspaces" locale={locale}>
	<p class="kicker">{t.workspacesArchive.kicker}</p>
	<h1>{t.workspacesArchive.heading}</h1>
	<p class="lede">{t.workspacesArchive.lede}</p>
	<p class="notice">{t.workspacesArchive.notice}</p>

	<ul class="workspace-list">
		{archived.map((workspace) => {
			const text = t.workspaces[workspace.id] ?? workspace;
			return (
				<li class="workspace">
					<h2><a href={localizePath(locale, workspace.route)}>{text.displayName}</a></h2>
					<p class="description">{text.description}</p>
					<p class="route"><code>{workspace.route}</code></p>
					<StatusTag
						status={workspace.status}
						implementationState={workspace.implementationState}
						enabled={workspace.enabled}
						locale={locale}
					/>
				</li>
			);
		})}
	</ul>

	<p class="back"><a href={localizePath(locale, '/workspaces')}>{t.workspacesArchive.backLink}</a></p>
</PlatformShell>

<style>
	.kicker {
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: var(--tracking-kicker);
		text-transform: uppercase;
		color: var(--color-text-tertiary);
		margin: 0 0 var(--space-sm);
	}

	h1 {
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 400;
		font-size: clamp(2rem, 5vw, 3rem);
		margin: 0 0 var(--space-sm);
	}

	.lede {
		color: var(--color-text-secondary);
		max-width: 60ch;
		margin: 0 0 var(--space-sm);
	}

	.notice {
		color: var(--color-text-muted);
		border-left: 2px solid var(--color-border);
		padding-left: var(--space-sm);
		max-width: 60ch;
		margin: 0 0 var(--space-lg);
	}

	.workspace-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-md);
	}

	.workspace {
		border: var(--border-hairline);
		padding: var(--space-md);
		opacity: 0.75;
	}

	.workspace h2 {
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 400;
		font-size: 1.4rem;
		margin: 0 0 var(--space-xs);
	}

	.workspace h2 a {
		color: var(--color-text-primary);
		text-decoration: none;
	}

	.workspace h2 a:hover {
		color: var(--color-accent);
	}

	.description {
		color: var(--color-text-secondary);
		margin: 0 0 var(--space-xs);
	}

	.route {
		margin: 0 0 var(--space-sm);
	}

	.route code {
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--color-text-muted);
	}

	.back {
		margin-top: var(--space-lg);
	}

	.back a {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: var(--tracking-kicker);
		text-transform: uppercase;
		color: var(--color-accent);
		text-decoration: none;
	}
</style>
