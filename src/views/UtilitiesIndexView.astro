---
// Utilities Library — fully registry-driven, no hardcoded cards. Mirrors
// InstrumentsIndexView.astro's structure (Sprint 010A: keep Shared
// Component design consistent), but reads from the independent Utility
// Registry (platform/utilities.ts) instead of the Instrument catalog.
import PlatformShell from '../layouts/PlatformShell.astro';
import { getDictionary, localizePath, type Locale } from '../i18n';
import { utilities } from '../platform/utilities.ts';

interface Props {
	locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const t = getDictionary(locale);
---

<PlatformShell title={`${t.utilitiesPage.heading} · ${t.seo.titleSuffix}`} section="utilities" locale={locale}>
	<p class="kicker">{t.utilitiesPage.kicker}</p>
	<h1>{t.utilitiesPage.heading}</h1>
	<p class="lede">{t.utilitiesPage.lede}</p>

	<ol class="utility-list">
		{utilities.map((utility, index) => {
			const text = t.utilities[utility.id] ?? utility;
			return (
				<li class="utility">
					<div class="utility-head">
						<span class="seq">{String(index + 1).padStart(2, '0')}</span>
						<span class="icon" aria-hidden="true">{utility.icon}</span>
						<h2>{text.displayName}</h2>
					</div>
					<p class="description">{text.description}</p>
					<p class="io">
						<span class="label">{t.utilitiesPage.inputTypeLabel}</span> {utility.inputType}
						<span class="sep" aria-hidden="true">→</span>
						<span class="label">{t.utilitiesPage.outputTypeLabel}</span> {utility.outputType}
					</p>
					<p class="category">{utility.category}</p>
					<p class="status-tags">
						<span class:list={['tag', utility.status === 'available' ? 'tag-live' : undefined]}>
							{t.common.utilityStatusTag.status[utility.status]}
						</span>
					</p>
					<p class="action">
						{utility.implementationState === 'implemented' ? (
							<a href={localizePath(locale, utility.route)}>{t.utilitiesPage.openUtility}</a>
						) : (
							<a href={localizePath(locale, utility.route)} class="planned">
								{t.utilitiesPage.comingSoon}
							</a>
						)}
					</p>
				</li>
			);
		})}
	</ol>
</PlatformShell>

<style>
	.kicker {
		font-family: var(--font-mono);
		font-size: 11px;
		font-weight: 500;
		letter-spacing: var(--tracking-kicker);
		text-transform: uppercase;
		color: var(--color-accent);
		margin: 0 0 var(--space-sm);
	}

	h1 {
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 400;
		font-size: clamp(2rem, 5vw, 3rem);
		margin: 0 0 var(--space-sm);
	}

	.lede {
		color: var(--color-text-secondary);
		margin: 0 0 var(--space-xl);
	}

	.utility-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: var(--space-sm);
	}

	.utility {
		border: var(--border-hairline);
		padding: var(--space-md);
		display: flex;
		flex-direction: column;
		gap: var(--space-xs);
	}

	.utility-head {
		display: flex;
		align-items: baseline;
		gap: var(--space-sm);
	}

	.seq {
		font-family: var(--font-mono);
		font-size: 11px;
		color: var(--color-text-muted);
	}

	.icon {
		font-style: normal;
	}

	h2 {
		font-family: var(--font-display);
		font-style: italic;
		font-weight: 400;
		font-size: 1.4rem;
		margin: 0;
	}

	.description {
		color: var(--color-text-secondary);
		margin: 0;
	}

	.io {
		margin: 0;
		color: var(--color-text-primary);
	}

	.io .label {
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-text-tertiary);
		margin-right: 4px;
	}

	.io .sep {
		margin: 0 var(--space-xs);
		color: var(--color-text-tertiary);
	}

	.category {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: var(--tracking-kicker);
		text-transform: uppercase;
		color: var(--color-text-tertiary);
		margin: 0;
	}

	.status-tags {
		display: flex;
		gap: var(--space-xs);
		margin: 0;
	}

	.tag {
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-text-secondary);
		border: var(--border-hairline);
		padding: 2px 8px;
	}

	.tag-live {
		color: var(--color-accent);
		border-color: var(--color-accent);
	}

	.action {
		margin: var(--space-xs) 0 0;
	}

	.action a {
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: var(--tracking-kicker);
		text-transform: uppercase;
		color: var(--color-accent);
		text-decoration: none;
		border-bottom: 1px solid var(--color-accent);
		padding-bottom: 2px;
	}

	.action a.planned {
		color: var(--color-text-tertiary);
		border-bottom-color: var(--color-border);
	}
</style>
