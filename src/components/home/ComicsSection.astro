---
// Comics: the main brand content. Tapping a panel opens it full screen —
// a comic is there to be read, and the collage thumbnails are small. The
// essay link stays its own control in the caption, so opening the picture
// and leaving for Jim's Talk can never be the same accidental tap.
//
// The status chip says plainly that WTLab itself has no comics page yet —
// do not soften that until a real page exists.
import { getDictionary, type Locale } from '../../i18n';
import { brandEpisodes } from '../../platform/brand-content.ts';

interface Props {
	locale?: Locale;
}
const { locale = 'en' } = Astro.props;
const t = getDictionary(locale).brandHome.comics;

// Two collage columns. Order inside each column balances the heights
// (square EP.001 sits with a landscape one), so this is layout, not ranking.
const byId = Object.fromEntries(brandEpisodes.map((episode) => [episode.id, episode]));
const columns = [
	[byId.ep001, byId.ep004],
	[byId.ep002, byId.ep003],
];
const tilts = ['-1deg', '0.8deg', '1deg', '-0.8deg'];
---

<section id="comics" class="bh-comics">
	<div class="bh-wrap">
		<p class="bh-kicker">{t.kicker}</p>
		<div class="bh-head">
			<h2>{t.heading}</h2>
			<span class="bh-status">{t.status}</span>
		</div>
		<p class="bh-lede">{t.lede}</p>

		<div class="bh-columns">
			{columns.map((column, columnIndex) => (
				<div class="bh-column">
					{column.map((episode, rowIndex) => (
						<figure style={`--tilt: ${tilts[(columnIndex * 2 + rowIndex) % tilts.length]}`}>
							<button
								type="button"
								class="bh-comic-open"
								data-comic={episode.image}
								data-comic-alt={t.episodes[episode.id].alt}
								aria-label={`${t.episodes[episode.id].name} — ${t.openComic}`}
							>
								<img
									src={episode.image}
									width={episode.width}
									height={episode.height}
									alt={t.episodes[episode.id].alt}
									loading="lazy"
									decoding="async"
								/>
							</button>
							<figcaption>
								<span class="bh-code">{episode.code}</span>
								<span class="bh-name">{t.episodes[episode.id].name}</span>
								<a class="bh-read" href={episode.articleUrl} target="_blank" rel="noopener">{t.readArticle}</a>
							</figcaption>
						</figure>
					))}
					{columnIndex === columns.length - 1 && (
						<div class="bh-blogcard">
							<p>{t.blogCardHeading}</p>
							<a href="#blog">{t.blogCardLink}</a>
						</div>
					)}
				</div>
			))}
		</div>
	</div>

	<dialog class="bh-lightbox" id="bh-lightbox">
		<button type="button" class="bh-lightbox-close" data-close aria-label={t.closeComic}>
			<span aria-hidden="true">✕</span>
			<span class="bh-lightbox-close-text">{t.closeComic}</span>
		</button>
		<img id="bh-lightbox-image" src="" alt="" />
	</dialog>
</section>

<style>
	.bh-comics {
		background: var(--bh-paper-2);
		border-top: 4px solid var(--bh-ink);
		border-bottom: 4px solid var(--bh-ink);
		padding: 84px 0 96px;
	}

	.bh-wrap {
		max-width: var(--bh-max);
		margin: 0 auto;
		padding: 0 var(--bh-gutter);
	}

	.bh-kicker {
		margin: 0 0 10px;
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.18em;
		color: var(--bh-grey);
	}

	.bh-head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 12px 16px;
		margin-bottom: 28px;
	}

	h2 {
		margin: 0;
		font-size: clamp(3.4rem, 5.8vw, 5.25rem);
		font-weight: 900;
		line-height: 1.05;
	}

	.bh-status {
		display: inline-block;
		padding: 5px 12px;
		border: 2px solid var(--bh-ink);
		border-radius: 999px;
		background: var(--bh-red);
		color: #ffffff;
		font-size: 14px;
		font-weight: 700;
		letter-spacing: 0.04em;
		line-height: 1.4;
		transform: rotate(-2deg);
	}

	.bh-lede {
		margin: 0 0 12px;
		max-width: 38em;
		font-size: clamp(1.05rem, 1.4vw, 1.25rem);
		line-height: 1.8;
	}

	.bh-columns {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 40px;
		align-items: start;
		margin-top: 28px;
	}

	.bh-column {
		display: flex;
		flex-direction: column;
		gap: 36px;
	}

	figure {
		margin: 0;
		border: 4px solid var(--bh-ink);
		background: var(--bh-ink);
		box-shadow: 6px 6px 0 var(--bh-ink);
		transform: rotate(var(--tilt, 0deg));
	}

	.bh-comic-open {
		display: block;
		width: 100%;
		padding: 0;
		border: 0;
		background: none;
		cursor: zoom-in;
	}

	figure img {
		display: block;
		width: 100%;
		height: auto;
	}

	figcaption {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 6px 12px;
		padding: 10px 14px;
		background: var(--bh-white);
		border-top: 4px solid var(--bh-ink);
	}

	.bh-code {
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.12em;
		background: var(--bh-yellow);
		border: 2px solid var(--bh-ink);
		padding: 2px 7px;
	}

	.bh-name {
		font-size: 20px;
		font-weight: 900;
	}

	.bh-read {
		margin-left: auto;
		font-size: 15px;
		font-weight: 700;
		text-decoration: underline;
		white-space: nowrap;
	}

	.bh-read {
		color: var(--bh-ink);
	}

	.bh-read:hover,
	.bh-read:focus-visible {
		text-decoration-thickness: 3px;
	}

	/* Full-screen reader. <dialog> brings the focus trap, Esc, and the
	   backdrop with it, so this is styling only. */
	.bh-lightbox {
		width: 100vw;
		max-width: 100vw;
		height: 100dvh;
		max-height: 100dvh;
		padding: 0;
		border: 0;
		background: transparent;
		overflow: hidden;
	}

	.bh-lightbox::backdrop {
		background: rgba(10, 8, 6, 0.92);
	}

	.bh-lightbox img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: contain;
	}

	.bh-lightbox-close {
		position: fixed;
		top: max(12px, env(safe-area-inset-top));
		right: 12px;
		z-index: 1;
		display: inline-flex;
		align-items: center;
		gap: 8px;
		min-height: 48px;
		padding: 0 18px;
		border: 3px solid var(--bh-ink);
		border-radius: 999px;
		background: var(--bh-yellow);
		color: var(--bh-ink);
		font-family: inherit;
		font-size: 16px;
		font-weight: 900;
		cursor: pointer;
	}

	@media (max-width: 700px) {
		.bh-lightbox-close-text {
			position: absolute;
			width: 1px;
			height: 1px;
			overflow: hidden;
			clip-path: inset(50%);
		}

		.bh-lightbox-close {
			padding: 0;
			width: 48px;
			justify-content: center;
		}
	}

	.bh-blogcard {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 6px 20px;
		padding: 18px 20px;
		border: 4px solid var(--bh-ink);
		background: var(--bh-yellow);
		transform: rotate(1deg);
	}

	.bh-blogcard p {
		margin: 0;
		flex-grow: 1;
		font-size: 22px;
		font-weight: 900;
		line-height: 1.3;
	}

	.bh-blogcard a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		font-size: 16px;
		font-weight: 700;
		color: var(--bh-ink);
	}

	@media (max-width: 760px) {
		.bh-comics {
			padding: 48px 0 56px;
		}

		.bh-columns {
			grid-template-columns: minmax(0, 1fr);
			gap: 26px;
		}

		/* One column: flatten so episodes read EP.001 → EP.004 in order. */
		.bh-column {
			display: contents;
		}

		figure:nth-of-type(1) {
			order: 0;
		}

		.bh-column:first-child figure:nth-of-type(2) {
			order: 3;
		}

		.bh-column:last-child figure:nth-of-type(1) {
			order: 1;
		}

		.bh-column:last-child figure:nth-of-type(2) {
			order: 2;
		}

		.bh-blogcard {
			order: 4;
		}

		.bh-name {
			font-size: 18px;
		}

		.bh-read {
			font-size: 14px;
		}
	}
</style>

<script>
	// One dialog, reused: the clicked panel hands over its source and alt
	// text before it opens, so there is never a stale picture to clear.
	// Esc, the backdrop scrim and focus handling come from <dialog> itself.
	const dialog = document.getElementById('bh-lightbox');
	const image = document.getElementById('bh-lightbox-image');

	if (dialog instanceof HTMLDialogElement && image instanceof HTMLImageElement) {
		for (const trigger of document.querySelectorAll('.bh-comic-open')) {
			trigger.addEventListener('click', () => {
				const source = trigger.getAttribute('data-comic');
				if (!source) return;
				image.src = source;
				image.alt = trigger.getAttribute('data-comic-alt') ?? '';
				dialog.showModal();
			});
		}

		dialog.addEventListener('click', (event) => {
			// Anywhere that is not the picture closes it: the backdrop, and the
			// letterboxed margins either side of a contained image.
			if (event.target === image) return;
			dialog.close();
		});
	}
</script>
