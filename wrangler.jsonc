{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Deliberately NOT "wtlab-platform": that name belongs to the Cloudflare
	// Pages project serving www.wtlab.co. This prototype Worker keeps its own
	// distinct name so it can never collide with production.
	"name": "wtlab-guest-workspace-prototype",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-01",

	// workers.dev stays on for direct prototype access. No custom domain, no cron.
	"workers_dev": true,

	// Path-level production route, live since 2026-09-10 (ADR-0004). Only the
	// guest API on www.wtlab.co reaches this Worker; every other path on the
	// domain — the whole frontend — is still served by the Cloudflare Pages
	// project. Kept here so a later `wrangler deploy` preserves it. Never widen
	// it to www.wtlab.co/* or www.wtlab.co/api/* without a separate decision.
	"routes": [{ "pattern": "www.wtlab.co/api/guest/*", "zone_name": "wtlab.co" }],

	// Astro stays `output: 'static'` (ADR-0004). The Worker serves that build
	// as-is and adds only /api/*.
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		// WTLab is a multi-page static site, not an SPA — a missing path must
		// 404 rather than be rewritten to an index page.
		"not_found_handling": "none",
		// Without this, a top-level navigation to /api/* is answered by the
		// asset handler before the Worker ever sees it.
		"run_worker_first": ["/api/*"]
	},

	// WTLab-owned D1, created for this prototype. Never Phoenix's database.
	// Production continues to be served by the Cloudflare Pages project until
	// promoting this Worker is separately decided and approved.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "wtlab-guest-workspace",
			"database_id": "56a81ea3-ba31-4e38-8b39-a7487fc883e6",
			"migrations_dir": "migrations"
		}
	]
}
